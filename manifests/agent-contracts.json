{
  "schemaVersion": "github-agent-contracts/v1",
  "purpose": "Deterministic role contracts used with the prose Agent profiles",
  "shared": {
    "preflight": ["journeyRepository", "workflow.json", "Context Receipt", "required inputs", "current approval state"],
    "evidenceLevels": ["CODE_VERIFIED", "TEST_VERIFIED", "DOC_STATED", "AI_INFERRED", "UNRESOLVED"],
    "outputStates": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "SKIPPED_WITH_EVIDENCE", "BLOCKED"],
    "stopOn": ["missing input", "stale receipt", "unresolved critical unknown", "scope conflict", "failed deterministic check"],
    "never": ["invent business rules", "approve own work", "merge", "push protected branch", "claim an unexecuted tool result"],
    "reportPublication": "A specialist may publish only its verified artifact to the current unprotected Journey branch and one Journey PR; publication never advances or approves a stage."
  },
  "agents": {
    "delivery-coordinator": { "stage": "CONTROL", "inputs": ["workflow.json", "all artifact statuses", "PR/check metadata"], "outputs": ["resume summary", "routing decision", "standup/risk/release report"], "mustRun": ["initialize-journey-workspace", "resume-workflow", "record-human-decision before advance-stage"], "qualityGates": ["never start a blocked stage", "follow stageOrder", "record actor/evidence"], "mutates": ["workflow.json only through attributable human decision and approved stage transition", "coordinator report"] },
    "epic-delivery-analyst": { "stage": "EPIC_INTAKE", "inputs": ["epic/change intake", "approved Journey onboarding", "approved technical HTTP graph", "repository list"], "outputs": ["epic contract", "ticket/channel matrix", "business delivery dependency DAG", "risk register"], "mustRun": ["start-epic or join-epic or change-epic", "analyze-epic-risk"], "qualityGates": ["every ticket has repository/channel/dependency or KNOWN_GAP", "missing technical edge blocks to code-context-analyst", "emergency changes have actor/reason/urgency"], "mutates": ["epic artifacts only"] },
    "code-context-analyst": { "stage": "CONTEXT", "inputs": ["Journey baseline", "target repositories", "onboarding"], "outputs": ["code context", "entry-point map", "HTTP call graph evidence", "known gaps"], "mustRun": ["build-repository-map", "assess-context-freshness", "analyze-code-context", "trace-api-contract", "analyze-http-call-graph", "onboard-journey when onboarding scope", "onboard-repository for missing repository evidence"], "qualityGates": ["sole author of technical cross-repository graph", "claims cite commit/file/symbol", "caller and callee proof or checked contract for CODE_PROVEN", "inferences are labeled", "read-only over source"], "mutates": ["Journey context artifacts only"] },
    "requirement-analyst": { "stage": "REQUIREMENTS", "inputs": ["baseline", "code context", "tickets", "prior decisions"], "outputs": ["requirement contract", "acceptance matrix", "unknowns", "compatibility/flag/test/E2E plan"], "mustRun": ["start-ticket", "grill-requirement", "analyze-code-context when needed"], "qualityGates": ["one Socratic question at a time", "AS_IS/TO_BE/UNKNOWN separated", "critical unknowns resolved or accepted"], "mutates": ["requirement artifact only"] },
    "solution-architect": { "stage": "DESIGN", "inputs": ["approved requirement", "code context", "Journey onboarding", "API graph"], "outputs": ["solution design", "API contract", "sequence diagrams", "ADRs", "migration/rollback plan"], "mustRun": ["design-solution", "assess-api-compatibility", "adr for significant decisions"], "qualityGates": ["consumers listed", "non-breaking default", "native-later release and flag plan explicit"], "mutates": ["design/ADR artifacts only"] },
    "planner": { "stage": "PLAN", "inputs": ["approved requirement", "approved design", "dependency DAG", "repo onboarding"], "outputs": ["ordered repo task plan", "task acceptance checks", "parallel waves", "rollback checkpoints"], "mustRun": ["plan-change"], "qualityGates": ["each task has repo/base commit/files/tests/owner handoff", "parallel tasks share no mutable artifact", "API before dependent clients when required"], "mutates": ["implementation plan only"] },
    "java-implementer": { "stage": "IMPLEMENTATION", "inputs": ["approved plan task", "API compatibility report", "Java repo instructions", "tests"], "outputs": ["code commits", "test evidence", "implementation report", "PR link"], "mustRun": ["implement-task", "java-development", "generate-tests when assigned"], "qualityGates": ["red-green-refactor", "reactive/error/validation behavior tested", "no unplanned breaking API"], "mutates": ["assigned Java repository branch"] },
    "web-implementer": { "stage": "IMPLEMENTATION", "inputs": ["approved plan task", "Figma/design evidence", "API contract", "web instructions"], "outputs": ["code commits", "component/browser test evidence", "analytics/accessibility evidence", "PR link"], "mustRun": ["implement-task", "web-development"], "qualityGates": ["loading/empty/error/permission states", "semantic/accessibility names", "tagging is separate from selectors"], "mutates": ["assigned Web repository branch"] },
    "ios-implementer": { "stage": "IMPLEMENTATION", "inputs": ["approved plan task", "API contract", "hybrid boundary", "release flag"], "outputs": ["code commits", "unit/UI test evidence", "device/manual notes", "PR link"], "mustRun": ["implement-task", "ios-development"], "qualityGates": ["Dynamic Type/Reduce Motion", "WebView allowlist and bridge schema", "native release train and rollback"], "mutates": ["assigned iOS repository branch"] },
    "android-implementer": { "stage": "IMPLEMENTATION", "inputs": ["approved plan task", "API contract", "hybrid boundary", "release flag"], "outputs": ["code commits", "unit/UI test evidence", "device/manual notes", "PR link"], "mustRun": ["implement-task", "android-development"], "qualityGates": ["Compose semantics/scaling", "WebView allowlist and bridge schema", "native release train and rollback"], "mutates": ["assigned Android repository branch"] },
    "test-designer": { "stage": "TEST", "inputs": ["approved requirement", "design", "plan", "implementation evidence", "CI results"], "outputs": ["risk-to-test matrix", "automated tests", "manual E2E plan/results links", "coverage gaps"], "mustRun": ["generate-tests", "plan-manual-e2e"], "qualityGates": ["contract-first tests", "failure/flag/compatibility coverage", "never fabricate manual PASS"], "mutates": ["test artifacts and assigned test files"] },
    "accessibility-qa": { "stage": "QUALITY_REVIEW", "inputs": ["UI diff", "design", "WCAG baseline", "tagging requirements"], "outputs": ["accessibility findings", "tagging findings", "manual verification checklist"], "mustRun": ["review-accessibility", "review-analytics-tagging"], "qualityGates": ["criterion/location/user impact/remediation", "BLOCKER blocks gate", "automation cannot sign off device/screen-reader behavior"], "mutates": ["QA report only"] },
    "pr-reviewer": { "stage": "REVIEW", "inputs": ["full diff", "requirement", "design", "plan", "test evidence", "security/observability evidence"], "outputs": ["severity-ranked review", "residual risks", "verification plan"], "mustRun": ["review-pr", "assess-api-compatibility when API changes"], "qualityGates": ["every finding has location/evidence/impact/remediation", "review is read-only", "clean result still lists residual risks"], "mutates": ["review artifact only"] }
  }
}
